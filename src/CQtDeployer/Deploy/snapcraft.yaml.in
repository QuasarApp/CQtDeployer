name: cqtdeployer # you probably want to 'snapcraft register <name>'
version: '@CQT_DEPLOYER_VERSION@'
title: CQtDeployer
summary: deploy your qt or c/c++ projects # 79 char long summary
description: |
  Console app for deploy qt libs.
  Key differences of this program
  Performance-this program deploys the application several times faster (up to 10 seconds)
  Flexibility-this application has flags that will help you configure the deployment as you need and your project
contact: https://github.com/QuasarApp/CQtDeployer
issues: https://github.com/QuasarApp/CQtDeployer/issues
source-code: https://github.com/QuasarApp/CQtDeployer
website: https://quasarapp.github.io/CQtDeployer/
license: LGPL-3.0

grade: stable # must be 'stable' to release into candidate/stable channels
confinement: strict # use 'strict' once you have the right plugs and slots
base: core22
icon: snap/gui/icon.png
apps:
  cqtdeployer:
    command: bin/bash $SNAP/CQtDeployer.sh
    plugs: [home, removable-media, process-control, system-backup]

  cqt:
    command: bin/bash $SNAP/cqt.sh
    plugs: [home, removable-media, process-control, system-backup]

lint:
  ignore:
    # issue #903: the snap keeps the full set of its stage-packages,
    # including the mesa GPU stack (team lead decision: the snap must
    # save all of the libraries it ships). The gpu linter wants the GPU
    # libraries from a content interface - this snap intentionally keeps
    # the bundled mesa stack, so the gpu linter is disabled. The library
    # linter reports the not-linked mesa/icu/wayland/xcb libraries as
    # unused - the warnings are suppressed for exactly these files
    # (https://documentation.ubuntu.com/snapcraft/stable/how-to/debugging/disable-a-linter).
    - gpu
    - library:
      - usr/lib/x86_64-linux-gnu/libGL.so.1*
      - usr/lib/x86_64-linux-gnu/libGLX_mesa.so.0*
      - usr/lib/x86_64-linux-gnu/libicuio.so*
      - usr/lib/x86_64-linux-gnu/libicutest.so*
      - usr/lib/x86_64-linux-gnu/libwayland-cursor.so.0*
      - usr/lib/x86_64-linux-gnu/libxcb-xinerama.so.0*

parts:
  cqtdeployer:
    # See 'snapcraft plugins'

    plugin: dump
    source: Distro/CQtDeployer_@CQT_DEPLOYER_VERSION@_@CMAKE_SYSTEM_NAME@_@CMAKE_SYSTEM_PROCESSOR@.zip

    stage-packages:
      # The full set of libraries of the snap is kept (issue #903, team
      # lead decision): the runtime dependencies of the QIF GUI tools
      # (binarycreator + installerbase, see QIF/) and of the console app,
      # plus the mesa stack (libgl1-mesa-glx). The linter warnings of the
      # intentionally staged mesa/wayland/xcb libraries are suppressed in
      # the lint section above instead of removing the libraries.
      - bash
      - libfreetype6
      - libpng16-16
      - dpkg
      - libwayland-cursor0
      - libxcb-icccm4
      - libxcb-image0
      - libxcb-keysyms1
      - libxcb-render-util0
      - libxcb-xinerama0
      - libfontconfig1
      - libxcb-glx0
      - libx11-xcb1
      - libxcb-randr0
      - libxcb-shape0
      - libxcb-sync1
      - libxcb-xfixes0
      - libxcb-xkb1
      - libxext6
      - libx11-6
      - libxkbcommon-x11-0
      - libxkbcommon0
      - libgl1-mesa-glx

    after: [ cqt-meta ]

    override-stage: |
      snapcraftctl stage
      chmod 777 -R "$SNAPCRAFT_STAGE"

  cqt-meta:
    plugin: dump
    source: src/CQtDeployer/Deploy/snap/

    override-stage: |
      snapcraftctl stage
      chmod 777 -R "$SNAPCRAFT_STAGE"

